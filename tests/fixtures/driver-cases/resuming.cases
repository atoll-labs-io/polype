# po-drive.md, ## Resuming: one case per row of the table, read top to bottom, first match wins.
# Each case_ function builds one project state; tests/driver-next-action.oracle.test.sh replays it.

# Row 1: no docs/research/<id>.md — the planner does the research and the plan.
case_resuming_01_no_research() {
  story s01-alpha command -
  start
  lane s01-alpha
  expect_lane s01-alpha plan 'no research'
}

# Row 2: research holding `Root cause: not found`, no validated plan.
case_resuming_02_root_cause_not_found() {
  story s01-alpha command -
  start
  lane s01-alpha
  research_in s01-alpha 'Root cause: not found'
  expect_lane s01-alpha ask 'Root cause: not found'
}

# Row 3: plan holding `Technical choice: waiting for a human`, without validated: yes.
case_resuming_03_technical_choice() {
  story s01-alpha command -
  start
  lane s01-alpha
  research_in s01-alpha
  plan_in s01-alpha no 'Technical choice: waiting for a human'
  expect_lane s01-alpha ask 'Technical choice: waiting for a human'
}

# Row 4: research present, plan absent — the plan is built on the research on disk.
case_resuming_04_research_without_plan() {
  story s01-alpha command -
  start
  lane s01-alpha
  research_in s01-alpha
  expect_lane s01-alpha plan 'research, no plan'
}

# Row 4 with ## Validating a wave's plans: a plan without validated: yes under Plan validation: human.
case_resuming_05_plan_waits_for_a_human() {
  setting 'Plan validation' human
  story s01-alpha command -
  start
  lane s01-alpha
  research_in s01-alpha
  plan_in s01-alpha no
  expect_lane s01-alpha validate-plan 'plan-validated refuses'
}

# Row 4 under Plan validation: autonomous: the planner resumes at its plan and approves it.
case_resuming_06_plan_autonomous() {
  story s01-alpha command -
  start
  lane s01-alpha
  research_in s01-alpha
  plan_in s01-alpha no
  expect_lane s01-alpha plan 'plan-validated refuses'
}

