#!/usr/bin/env bash
# po-lint — mechanically checks the invariants of a method/ tree and prints one
# `<file>:<line>: [<rule>] <message>` per breach, exit 1 when there is any.
#
# Every rule here must be decidable without interpreting a sentence: presence of a
# declaration, a tool in a frontmatter, a trigger and its consequence on the same
# line. A rule that would need to understand prose belongs in a review, not here.
# Usage: po-lint [--base <ref>] [method directory]   (default: the method/ next to this script)
set -u

BASE=""
if [ "${1:-}" = --base ]; then
  [ -n "${2:-}" ] || { echo "po-lint: --base needs a git ref" >&2; exit 2; }
  BASE="$2"
  shift 2
fi
# A --base given after the directory would otherwise skip the raise check without a word.
[ $# -le 1 ] || { echo "usage: po-lint [--base <ref>] [method directory]" >&2; exit 2; }

METHOD="${1:-$(dirname "$0")/../method}"
[ -d "$METHOD" ] || { echo "po-lint: no such method directory: $METHOD" >&2; exit 2; }
METHOD="$(cd "$METHOD" && pwd)"

# A branch is judged on what it changed since it forked from the base, never on what the base did since.
BASE_BUDGET=""
if [ -n "$BASE" ]; then
  base_commit="$(git -C "$METHOD" rev-parse --verify -q "$BASE^{commit}" 2>/dev/null)" \
    && base_commit="$(git -C "$METHOD" merge-base HEAD "$base_commit" 2>/dev/null)" \
    || { echo "po-lint: no base to compare the word budget with: $BASE" >&2; exit 2; }
  BASE_BUDGET="$(git -C "$METHOD" show "$base_commit:./word-budget" 2>/dev/null)" || BASE_BUDGET=""
fi

breaches=0
report() {
  printf '%s:%s: [%s] %s\n' "$1" "$2" "$3" "$4"
  breaches=$((breaches + 1))
}

# --- shared parsing -----------------------------------------------------------

frontmatter() {
  awk 'NR==1 && $0=="---" {inside=1; next} inside && $0=="---" {exit} inside' "$1"
}

# `<line number><TAB><tool>` for either `allowed-tools:` (YAML list) or `tools: A, B`.
tools_numbered() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^allowed-tools:/ {list=1; next}
    list && /^  - / {t=$0; sub(/^  - /, "", t); print NR "\t" t; next}
    list && !/^  - / {list=0}
    /^tools:/ {t=$0; sub(/^tools:[[:space:]]*/, "", t); n=split(t, a, /,[[:space:]]*/); for (i=1;i<=n;i++) print NR "\t" a[i]}
  ' "$1"
}

# The line declaring the tools, 0 when the file declares none.
tools_declaration_line() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^allowed-tools:/ || /^tools:/ {print NR; found=1; exit}
    END {if (!found) print 0}
  ' "$1"
}

# Skills a subagent declares, from the `skills:` list of its frontmatter.
skills_of() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^skills:/ {list=1; next}
    list && /^  - / {s=$0; sub(/^  - /, "", s); print s; next}
    list && !/^  - / {list=0}
  ' "$1"
}

# First line of the body (frontmatter excluded) holding a literal string.
body_first_line() {
  awk -v pat="$2" '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {fm=2; next}
    fm==2 && index($0, pat) {print NR; exit}
  ' "$1"
}

# The file list is built once, here, and every rule iterates that same list: a
# listing evaluated inside three process substitutions can fail three times
# without anyone reading its status, and the run then ends on a clean summary
# having checked nothing.
METHOD_FILES="$(ls "$METHOD"/commands/*.md "$METHOD"/agents/*.md 2>/dev/null || true)"
METHOD_FILE_COUNT=0
[ -z "$METHOD_FILES" ] || METHOD_FILE_COUNT="$(grep -c '' <<< "$METHOD_FILES")"

if [ "$METHOD_FILE_COUNT" -eq 0 ]; then
  echo "po-lint: read 0 file(s) in ${METHOD##*/}/: nothing was checked" >&2
  exit 2
fi

# --- rule: settings -----------------------------------------------------------
# Every command and subagent declares the settings it reads, and each name it
# declares exists in the settings template. `Reads settings: none` carries no
# backtick and stays valid.

TEMPLATE="$METHOD/templates/agents-local.md"
TEMPLATE_SETTINGS=""
if [ -f "$TEMPLATE" ]; then
  TEMPLATE_SETTINGS=$(awk '/^```/ {fence=!fence; next} fence && NF {sub(/:.*/, ""); print}' "$TEMPLATE")
else
  report "templates/agents-local.md" 1 settings "the settings template is missing"
fi

check_settings() {
  local f rel hit lineno text name
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    hit=$(grep -n -m1 '^Reads settings:' "$f" || true)
    if [ -z "$hit" ]; then
      report "$rel" 1 settings "no 'Reads settings:' line"
      continue
    fi
    lineno="${hit%%:*}"
    text="${hit#*:}"
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      grep -qxF "$name" <<< "$TEMPLATE_SETTINGS" \
        || report "$rel" "$lineno" settings "reads unknown setting '$name'"
    done < <(grep -o '`[^`]*`' <<< "$text" | tr -d '`' || true)
  done <<< "$METHOD_FILES"
}

# --- rule: tools --------------------------------------------------------------
# The tool frontmatter must match the contract the file states: a command asking
# a question declares AskUserQuestion, whoever delegates does not edit, a command
# announced as unable to touch the code declares no writing tool, and a subagent
# that judges cannot write.

PO_NEXT_TOOL='Bash("${CLAUDE_CONFIG_DIR:-$HOME/.claude}/polype/po" next)'

check_tools() {
  local f rel tools decl line tool askline
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    decl=$(tools_declaration_line "$f")
    [ "$decl" != 0 ] || continue
    tools=$(tools_numbered "$f")

    askline=$(body_first_line "$f" AskUserQuestion)
    if [ -n "$askline" ] && ! cut -f2 <<< "$tools" | grep -qx AskUserQuestion; then
      report "$rel" "$askline" tools "the body asks a question but AskUserQuestion is not declared"
    fi

    if cut -f2 <<< "$tools" | grep -qx Agent; then
      while IFS=$'\t' read -r line tool; do
        [ "$tool" = Edit ] && report "$rel" "$line" tools "declares Agent and Edit: whoever delegates does not edit"
      done <<< "$tools"
    fi

    if frontmatter "$f" | grep -qF 'cannot edit files or run a shell'; then
      while IFS=$'\t' read -r line tool; do
        # ADR-0120: /po-execute may read po next, and that verb only.
        [ "$rel" = commands/po-execute.md ] && [ "$tool" = "$PO_NEXT_TOOL" ] && continue
        case "$tool" in
          Write|Edit|Bash|Bash\(*) report "$rel" "$line" tools "says it cannot edit files or run a shell but declares $tool" ;;
        esac
      done <<< "$tools"
    fi

    if skills_of "$f" | grep -qxE 'review-antihallu|stories-review'; then
      while IFS=$'\t' read -r line tool; do
        [ "$tool" = Write ] && report "$rel" "$line" tools "judges a story but declares Write"
      done <<< "$tools"
    fi
  done <<< "$METHOD_FILES"
}

# --- rule: fail-closed --------------------------------------------------------
# Inside the gate sections only, `## By hand` among them, a rule whose trigger names
# an absence must say stop, ask, carry on or never blocks before its clause ends, so
# a stop further down the line cannot vouch for it. The scope is narrow on purpose: over a
# whole file, 28 of 95 arrow lines are legitimate non-blocking branches, so the
# same rule applied everywhere would be a false-positive machine.

check_fail_closed() {
  local f rel
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    while IFS=$'\t' read -r line text; do
      report "$rel" "$line" fail-closed "an absence triggers no stop: $text"
    done < <(awk '
      /^## / {gate = ($0 ~ /^## (Checks|Preconditions|Step 0|By hand)/)}
      gate {
        n = split($0, part, /→/)
        for (k = 2; k <= n; k++) {
          if (part[k-1] !~ /No |no |None|none|Missing|missing|not |`—`|Any other|Another/) continue
          outcome = part[k]
          sub(/(;|\. ).*/, "", outcome)
          if (outcome ~ /stop|ask|carry on|never blocks/) continue
          printf "%d\t%s\n", NR, $0
        }
      }
    ' "$f")
  done <<< "$METHOD_FILES"
}

# --- rule: profiles -----------------------------------------------------------
# Every boilerplate profile follows the profile template: its sections, the
# command names of its Commands fence and the capability names of its table all
# come from the template, and each value of its `- Platform:` line is one of the
# backticked lowercase words of the `| Platform |` row of the settings template
# (ADR-0055), so no list is repeated here. The value of its `- QA driver:` line
# is `—` or the name of a driver file of method/skills/qa-drivers/ (ADR-0057).
# Its `## Strictness` section holds its three lines; their values are not checked
# (ADR-0097).
# A profile whose driver is `mobile-web` needs a `Dev` command other than `—`,
# since that driver drives what `Dev` serves.
# The boilerplates/ folder sits beside method/; without it there is nothing to check.

PROFILE_TEMPLATE="$METHOD/templates/profile.md"
BOILERPLATES="$METHOD/../boilerplates"

# `<line><TAB><name>` of each command named in the fence of `## Commands`.
profile_commands() {
  awk '
    /^## / {sec = ($0 == "## Commands"); next}
    sec && /^```/ {fence = !fence; next}
    sec && fence && NF {n = $0; sub(/:.*/, "", n); sub(/^[[:space:]]+/, "", n); print NR "\t" n}
  ' "$1"
}

# Trimmed value of the command named $2 in the fence of `## Commands`.
profile_command_value() {
  awk -v want="$2" '
    /^## / {sec = ($0 == "## Commands"); next}
    sec && /^```/ {fence = !fence; next}
    sec && fence && NF {
      n = $0; sub(/:.*/, "", n); sub(/^[[:space:]]+/, "", n)
      if (n != want) next
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); print v; exit
    }
  ' "$1"
}

# `<line><TAB><value>` of the first `- Platform:` line under `## Platform`.
profile_platform_line() {
  awk '
    /^## / {sec = ($0 == "## Platform"); next}
    sec && /^- Platform:/ {v = $0; sub(/^- Platform:[[:space:]]*/, "", v); print NR "\t" v; exit}
  ' "$1"
}

# `<line><TAB><value>` of the first `- QA driver:` line under `## QA driver`.
profile_driver_line() {
  awk '
    /^## / {sec = ($0 == "## QA driver"); next}
    sec && /^- QA driver:/ {v = $0; sub(/^- QA driver:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); print NR "\t" v; exit}
  ' "$1"
}

# `<line><TAB><value>` of the first `- $3:` line under the section `## $2`.
profile_field_line() {
  awk -v sec_name="## $2" -v field="- $3:" '
    /^## / {sec = ($0 == sec_name); next}
    sec && index($0, field) == 1 {v = substr($0, length(field) + 1); sub(/^[[:space:]]+/, "", v); print NR "\t" v; exit}
  ' "$1"
}

# `<line><TAB><name>` of each row of the `## Capabilities` table, header and separator excluded.
profile_capabilities() {
  awk '
    /^## / {sec = ($0 == "## Capabilities"); next}
    sec && /^\|/ {
      split($0, cell, "|"); c = cell[2]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", c)
      if (c == "Capability" || c ~ /^:?-+:?$/) next
      print NR "\t" c
    }
  ' "$1"
}

check_profiles() {
  local sections commands capabilities platforms f rel heading line name cmdline platline drvline strictline value
  if [ ! -f "$PROFILE_TEMPLATE" ]; then
    report "templates/profile.md" 1 profile "the profile template is missing"
    return
  fi
  [ -d "$BOILERPLATES" ] || return 0
  sections=$(grep '^## ' "$PROFILE_TEMPLATE")
  commands=$(profile_commands "$PROFILE_TEMPLATE" | cut -f2)
  capabilities=$(profile_capabilities "$PROFILE_TEMPLATE" | cut -f2)
  platforms=$(grep -m1 '^| Platform |' "$TEMPLATE" 2>/dev/null | grep -o '`[a-z][a-z]*`' | tr -d '`' || true)
  [ -n "$platforms" ] \
    || report "templates/agents-local.md" 1 profile "no Platform values in the settings table"

  for f in "$BOILERPLATES"/*/profile.md; do
    [ -f "$f" ] || continue
    rel="boilerplates/${f#"$BOILERPLATES"/}"
    while IFS= read -r heading; do
      grep -qxF -- "$heading" "$f" || report "$rel" 1 profile "missing section '$heading'"
    done <<< "$sections"

    cmdline=$(grep -n -m1 -x '## Commands' "$f" | cut -d: -f1)
    if [ -n "$cmdline" ]; then
      while IFS=$'\t' read -r line name; do
        [ -n "$name" ] || continue
        grep -qxF -- "$name" <<< "$commands" \
          || report "$rel" "$line" profile "command '$name' is not a setting of the template"
      done < <(profile_commands "$f")
      while IFS= read -r name; do
        profile_commands "$f" | cut -f2 | grep -qxF -- "$name" \
          || report "$rel" "$cmdline" profile "command '$name' is missing"
      done <<< "$commands"
    fi

    platline=$(grep -n -m1 -x '## Platform' "$f" | cut -d: -f1)
    if [ -n "$platline" ]; then
      line=""
      IFS=$'\t' read -r line value < <(profile_platform_line "$f") || true
      if [ -z "${line:-}" ]; then
        report "$rel" "$platline" profile "no '- Platform:' line under '## Platform'"
      else
        while IFS= read -r name; do
          name=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "$name")
          grep -qxF -- "$name" <<< "$platforms" \
            || report "$rel" "$line" profile "platform '$name' is not a value of the Platform setting"
        done < <(tr ',' '\n' <<< "$value")
      fi
    fi

    drvline=$(grep -n -m1 -x '## QA driver' "$f" | cut -d: -f1)
    if [ -n "$drvline" ]; then
      line=""
      IFS=$'\t' read -r line value < <(profile_driver_line "$f") || true
      if [ -z "${line:-}" ]; then
        report "$rel" "$drvline" profile "no '- QA driver:' line under '## QA driver'"
      elif [ "$value" != "—" ] && { [ "$value" = SKILL ] || [[ "$value" == */* ]] \
          || [ ! -f "$METHOD/skills/qa-drivers/$value.md" ]; }; then
        report "$rel" "$line" profile "QA driver '$value' is not a file of qa-drivers"
      elif [ "$value" = mobile-web ] && [ "$(profile_command_value "$f" Dev)" = "—" ]; then
        report "$rel" "$line" profile "QA driver 'mobile-web' needs a Dev command, and Dev is '—'"
      fi
    fi

    strictline=$(grep -n -m1 -x '## Strictness' "$f" | cut -d: -f1)
    if [ -n "$strictline" ]; then
      for name in "Strict check" "Turned on by" "Passes at the commit profiled"; do
        [ -n "$(profile_field_line "$f" Strictness "$name")" ] \
          || report "$rel" "$strictline" profile "no '- $name:' line under '## Strictness'"
      done
    fi

    while IFS=$'\t' read -r line name; do
      [ -n "$name" ] || continue
      grep -qxF -- "$name" <<< "$capabilities" \
        || report "$rel" "$line" profile "capability '$name' is not in the template list"
    done < <(profile_capabilities "$f")
  done
}

# --- rule: budget -------------------------------------------------------------
# word-budget holds the word ceiling of every .md file of method/ and of their total;
# hooks are code and hold none. Its ../ lines are documents of the repository, checked
# only when method/ sits at its root. With --base, a ceiling raised since the base must
# cite a new owner's decision as third field. A word is a run of characters between blanks,
# tabs and newlines, counted by awk in the C locale: wc -w differs across coreutils versions.

BUDGET="$METHOD/word-budget"

words() { LC_ALL=C awk '{n += NF} END {print n + 0}' < "$1"; }

documents_checked() {
  local parent top
  parent="$(cd "$METHOD/.." && pwd -P)" || return 1
  top="$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$top" ] && [ "$(cd "$top" && pwd -P)" = "$parent" ]
}

check_budget() {
  local f counts="" docs="" checked=0 key rest file line text
  if [ ! -f "$BUDGET" ]; then
    report word-budget 1 budget "no word budget"
    return
  fi
  while IFS= read -r f; do
    # A symlink is read through, as the other rules read method/; one that leads to no file is skipped.
    [ -n "$f" ] && [ -f "$METHOD/$f" ] || continue
    counts+="$f"$'\t'"$(words "$METHOD/$f")"$'\n'
  done < <(cd "$METHOD" && find . \( -type f -o -type l \) -name '*.md' | sed 's|^\./||' | LC_ALL=C sort)
  if documents_checked; then
    checked=1
    while IFS= read -r key; do
      rest="${key#../}"
      case "/$rest/" in //*|*/../*) continue ;; esac
      if [ -f "$METHOD/$key" ]; then
        docs+="$key"$'\t'"$(words "$METHOD/$key")"$'\n'
      else
        docs+="$key"$'\t-\n'
      fi
    done < <(awk '$1 ~ /^\.\.\// {print $1}' "$BUDGET")
  fi
  while IFS=$'\t' read -r file line text; do
    report "$file" "$line" budget "$text"
  done < <(BUDGET_COUNTS="$counts" BUDGET_DOCS="$docs" BUDGET_CHECKED="$checked" BUDGET_BASE="$BASE_BUDGET" awk '
    function int_ok(v) { return v ~ /^[0-9]+$/ }
    function bad_path(rest,   n, i, part) {
      if (rest == "" || rest ~ /^\//) return 1
      n = split(rest, part, "/")
      for (i = 1; i <= n; i++) if (part[i] == "..") return 1
      return 0
    }
    function out(l, msg) { printf "word-budget\t%d\t%s\n", l, msg }
    BEGIN {
      n = split(ENVIRON["BUDGET_COUNTS"], rows, "\n")
      for (i = 1; i <= n; i++) {
        if (rows[i] == "") continue
        split(rows[i], kv, "\t"); count[kv[1]] = kv[2]; order[++files] = kv[1]; sum += kv[2]
      }
      n = split(ENVIRON["BUDGET_DOCS"], rows, "\n")
      for (i = 1; i <= n; i++) {
        if (rows[i] == "") continue
        split(rows[i], kv, "\t"); doc[kv[1]] = kv[2]
      }
      checked = ENVIRON["BUDGET_CHECKED"] == 1
      n = split(ENVIRON["BUDGET_BASE"], rows, "\n")
      for (i = 1; i <= n; i++) {
        if (rows[i] ~ /^#/) continue
        m = split(rows[i], f, " ")
        if (m >= 2 && int_ok(f[2])) { base[f[1]] = f[2]; cited[f[1]] = (m >= 3 ? f[3] : "") }
      }
    }
    /^[[:space:]]*$/ || /^#/ { next }
    {
      if (!(int_ok($2) && (NF == 2 || (NF == 3 && $3 ~ /^d-[0-9]+$/)))) { out(NR, "malformed line: " $0); next }
      key = $1
      if (key in seen) { out(NR, key " is listed twice"); next }
      seen[key] = NR
      if (key == "total") { total = $2 + 0; totline = NR }
      else if (substr(key, 1, 3) == "../") {
        if (bad_path(substr(key, 4))) { out(NR, "malformed line: " $0); next }
        if (!checked) next
        if (doc[key] == "-") out(NR, key " names no file of the repository")
        else if (doc[key] + 0 > $2 + 0) out(NR, key " holds " doc[key] " words, over its ceiling of " $2)
      }
      else if (!(key in count)) { out(NR, key " is no .md file of method/"); next }
      else if (count[key] + 0 > $2 + 0) out(NR, key " holds " count[key] " words, over its ceiling of " $2)
      if ((key in base) && $2 + 0 > base[key] + 0 && ($3 == "" || $3 == cited[key]))
        out(NR, key " raised from " base[key] " to " $2 " with no new decision of the owner")
    }
    END {
      for (i = 1; i <= files; i++)
        if (!(order[i] in seen)) printf "%s\t1\tno line in word-budget\n", order[i]
      if (!totline) out(1, "no total line")
      else if (sum > total) out(totline, "the .md files of method/ hold " sum " words, over the total ceiling of " total)
    }
  ' "$BUDGET")
}

# --- rule: cd-git
check_cd_git() {
  local f hit line
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$METHOD/$f" ] || continue
    while IFS=: read -r line hit; do
      [ -n "$line" ] && report "$f" "$line" cd-git "a cd precedes git: run git as git -C <path>"
    done < <(grep -nE '(^|[^[:alnum:]_.-])cd[[:space:]][^`]*(&&|;|\|\|)[[:space:]]*git([[:space:]]|`|$)' "$METHOD/$f" || true)
  done < <(cd "$METHOD" && find . \( -type f -o -type l \) | sed 's|^\./||' | LC_ALL=C sort)
}

check_settings
check_tools
check_profiles
check_fail_closed
check_budget
check_cd_git

if [ "$breaches" -eq 0 ]; then
  echo "po-lint: no breach in $METHOD_FILE_COUNT file(s) of ${METHOD##*/}/"
else
  echo "po-lint: $breaches breach(es) in $METHOD_FILE_COUNT file(s) of ${METHOD##*/}/"
fi
[ "$breaches" -eq 0 ]
