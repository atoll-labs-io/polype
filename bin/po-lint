#!/usr/bin/env bash
# po-lint — mechanically checks the invariants of a method/ tree and prints one
# `<file>:<line>: [<rule>] <message>` per breach, exit 1 when there is any.
#
# Every rule here must be decidable without interpreting a sentence: presence of a
# declaration, a tool in a frontmatter, a trigger and its consequence on the same
# line. A rule that would need to understand prose belongs in a review, not here.
# Usage: po-lint [method directory]   (default: the method/ next to this script)
set -u

METHOD="${1:-$(dirname "$0")/../method}"
[ -d "$METHOD" ] || { echo "po-lint: no such method directory: $METHOD" >&2; exit 2; }
METHOD="$(cd "$METHOD" && pwd)"

breaches=0
report() {
  printf '%s:%s: [%s] %s\n' "$1" "$2" "$3" "$4"
  breaches=$((breaches + 1))
}

# --- shared parsing -----------------------------------------------------------

frontmatter() {
  awk 'NR==1 && $0=="---" {inside=1; next} inside && $0=="---" {exit} inside' "$1"
}

# `<line number><TAB><tool>` for either `allowed-tools:` (YAML list) or `tools: A, B`.
tools_numbered() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^allowed-tools:/ {list=1; next}
    list && /^  - / {t=$0; sub(/^  - /, "", t); print NR "\t" t; next}
    list && !/^  - / {list=0}
    /^tools:/ {t=$0; sub(/^tools:[[:space:]]*/, "", t); n=split(t, a, /,[[:space:]]*/); for (i=1;i<=n;i++) print NR "\t" a[i]}
  ' "$1"
}

# The line declaring the tools, 0 when the file declares none.
tools_declaration_line() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^allowed-tools:/ || /^tools:/ {print NR; found=1; exit}
    END {if (!found) print 0}
  ' "$1"
}

# Skills a subagent declares, from the `skills:` list of its frontmatter.
skills_of() {
  awk '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {exit}
    fm!=1 {next}
    /^skills:/ {list=1; next}
    list && /^  - / {s=$0; sub(/^  - /, "", s); print s; next}
    list && !/^  - / {list=0}
  ' "$1"
}

# First line of the body (frontmatter excluded) holding a literal string.
body_first_line() {
  awk -v pat="$2" '
    NR==1 && $0=="---" {fm=1; next}
    fm==1 && $0=="---" {fm=2; next}
    fm==2 && index($0, pat) {print NR; exit}
  ' "$1"
}

# The file list is built once, here, and every rule iterates that same list: a
# listing evaluated inside three process substitutions can fail three times
# without anyone reading its status, and the run then ends on a clean summary
# having checked nothing.
METHOD_FILES="$(ls "$METHOD"/commands/*.md "$METHOD"/agents/*.md 2>/dev/null || true)"
METHOD_FILE_COUNT=0
[ -z "$METHOD_FILES" ] || METHOD_FILE_COUNT="$(grep -c '' <<< "$METHOD_FILES")"

if [ "$METHOD_FILE_COUNT" -eq 0 ]; then
  echo "po-lint: read 0 file(s) in ${METHOD##*/}/: nothing was checked" >&2
  exit 2
fi

# --- rule: settings -----------------------------------------------------------
# Every command and subagent declares the settings it reads, and each name it
# declares exists in the settings template. `Reads settings: none` carries no
# backtick and stays valid.

TEMPLATE="$METHOD/templates/agents-local.md"
TEMPLATE_SETTINGS=""
if [ -f "$TEMPLATE" ]; then
  TEMPLATE_SETTINGS=$(awk '/^```/ {fence=!fence; next} fence && NF {sub(/:.*/, ""); print}' "$TEMPLATE")
else
  report "templates/agents-local.md" 1 settings "the settings template is missing"
fi

check_settings() {
  local f rel hit lineno text name
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    hit=$(grep -n -m1 '^Reads settings:' "$f" || true)
    if [ -z "$hit" ]; then
      report "$rel" 1 settings "no 'Reads settings:' line"
      continue
    fi
    lineno="${hit%%:*}"
    text="${hit#*:}"
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      grep -qxF "$name" <<< "$TEMPLATE_SETTINGS" \
        || report "$rel" "$lineno" settings "reads unknown setting '$name'"
    done < <(grep -o '`[^`]*`' <<< "$text" | tr -d '`' || true)
  done <<< "$METHOD_FILES"
}

# --- rule: tools --------------------------------------------------------------
# The tool frontmatter must match the contract the file states: a command asking
# a question declares AskUserQuestion, whoever delegates does not edit, a command
# announced as unable to touch the code declares no writing tool, and a subagent
# that judges cannot write.

check_tools() {
  local f rel tools decl line tool askline
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    decl=$(tools_declaration_line "$f")
    [ "$decl" != 0 ] || continue
    tools=$(tools_numbered "$f")

    askline=$(body_first_line "$f" AskUserQuestion)
    if [ -n "$askline" ] && ! cut -f2 <<< "$tools" | grep -qx AskUserQuestion; then
      report "$rel" "$askline" tools "the body asks a question but AskUserQuestion is not declared"
    fi

    if cut -f2 <<< "$tools" | grep -qx Agent; then
      while IFS=$'\t' read -r line tool; do
        [ "$tool" = Edit ] && report "$rel" "$line" tools "declares Agent and Edit: whoever delegates does not edit"
      done <<< "$tools"
    fi

    if frontmatter "$f" | grep -qF 'cannot edit files or run a shell'; then
      while IFS=$'\t' read -r line tool; do
        case "$tool" in
          Write|Edit|Bash) report "$rel" "$line" tools "says it cannot edit files or run a shell but declares $tool" ;;
        esac
      done <<< "$tools"
    fi

    if skills_of "$f" | grep -qxE 'review-antihallu|stories-review'; then
      while IFS=$'\t' read -r line tool; do
        [ "$tool" = Write ] && report "$rel" "$line" tools "judges a story but declares Write"
      done <<< "$tools"
    fi
  done <<< "$METHOD_FILES"
}

# --- rule: fail-closed --------------------------------------------------------
# Inside the gate sections only, a rule whose trigger names an absence must say
# stop, ask, carry on or never blocks. The scope is narrow on purpose: over a
# whole file, 28 of 95 arrow lines are legitimate non-blocking branches, so the
# same rule applied everywhere would be a false-positive machine.

check_fail_closed() {
  local f rel
  while IFS= read -r f; do
    rel="${f#"$METHOD"/}"
    while IFS=$'\t' read -r line text; do
      report "$rel" "$line" fail-closed "an absence triggers no stop: $text"
    done < <(awk '
      /^## / {gate = ($0 ~ /^## (Checks|Preconditions|Step 0)/)}
      gate {
        n = split($0, part, /→/)
        for (k = 2; k <= n; k++) {
          if (part[k-1] !~ /No |no |None|none|Missing|missing|not |`—`|Any other|Another/) continue
          if (part[k] ~ /stop|ask|carry on|never blocks/) continue
          printf "%d\t%s\n", NR, $0
        }
      }
    ' "$f")
  done <<< "$METHOD_FILES"
}

# --- rule: profiles -----------------------------------------------------------
# Every boilerplate profile follows the profile template: its sections, the
# command names of its Commands fence and the capability names of its table all
# come from the template, and each value of its `- Platform:` line is one of the
# backticked lowercase words of the `| Platform |` row of the settings template
# (ADR-0055), so no list is repeated here. The value of its `- QA driver:` line
# is `—` or the name of a driver file of method/skills/qa-drivers/ (ADR-0057).
# The boilerplates/ folder sits beside method/; without it there is nothing to check.

PROFILE_TEMPLATE="$METHOD/templates/profile.md"
BOILERPLATES="$METHOD/../boilerplates"

# `<line><TAB><name>` of each command named in the fence of `## Commands`.
profile_commands() {
  awk '
    /^## / {sec = ($0 == "## Commands"); next}
    sec && /^```/ {fence = !fence; next}
    sec && fence && NF {n = $0; sub(/:.*/, "", n); sub(/^[[:space:]]+/, "", n); print NR "\t" n}
  ' "$1"
}

# `<line><TAB><value>` of the first `- Platform:` line under `## Platform`.
profile_platform_line() {
  awk '
    /^## / {sec = ($0 == "## Platform"); next}
    sec && /^- Platform:/ {v = $0; sub(/^- Platform:[[:space:]]*/, "", v); print NR "\t" v; exit}
  ' "$1"
}

# `<line><TAB><value>` of the first `- QA driver:` line under `## QA driver`.
profile_driver_line() {
  awk '
    /^## / {sec = ($0 == "## QA driver"); next}
    sec && /^- QA driver:/ {v = $0; sub(/^- QA driver:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); print NR "\t" v; exit}
  ' "$1"
}

# `<line><TAB><name>` of each row of the `## Capabilities` table, header and separator excluded.
profile_capabilities() {
  awk '
    /^## / {sec = ($0 == "## Capabilities"); next}
    sec && /^\|/ {
      split($0, cell, "|"); c = cell[2]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", c)
      if (c == "Capability" || c ~ /^:?-+:?$/) next
      print NR "\t" c
    }
  ' "$1"
}

check_profiles() {
  local sections commands capabilities platforms f rel heading line name cmdline platline drvline value
  if [ ! -f "$PROFILE_TEMPLATE" ]; then
    report "templates/profile.md" 1 profile "the profile template is missing"
    return
  fi
  [ -d "$BOILERPLATES" ] || return 0
  sections=$(grep '^## ' "$PROFILE_TEMPLATE")
  commands=$(profile_commands "$PROFILE_TEMPLATE" | cut -f2)
  capabilities=$(profile_capabilities "$PROFILE_TEMPLATE" | cut -f2)
  platforms=$(grep -m1 '^| Platform |' "$TEMPLATE" 2>/dev/null | grep -o '`[a-z][a-z]*`' | tr -d '`' || true)
  [ -n "$platforms" ] \
    || report "templates/agents-local.md" 1 profile "no Platform values in the settings table"

  for f in "$BOILERPLATES"/*/profile.md; do
    [ -f "$f" ] || continue
    rel="boilerplates/${f#"$BOILERPLATES"/}"
    while IFS= read -r heading; do
      grep -qxF -- "$heading" "$f" || report "$rel" 1 profile "missing section '$heading'"
    done <<< "$sections"

    cmdline=$(grep -n -m1 -x '## Commands' "$f" | cut -d: -f1)
    if [ -n "$cmdline" ]; then
      while IFS=$'\t' read -r line name; do
        [ -n "$name" ] || continue
        grep -qxF -- "$name" <<< "$commands" \
          || report "$rel" "$line" profile "command '$name' is not a setting of the template"
      done < <(profile_commands "$f")
      while IFS= read -r name; do
        profile_commands "$f" | cut -f2 | grep -qxF -- "$name" \
          || report "$rel" "$cmdline" profile "command '$name' is missing"
      done <<< "$commands"
    fi

    platline=$(grep -n -m1 -x '## Platform' "$f" | cut -d: -f1)
    if [ -n "$platline" ]; then
      line=""
      IFS=$'\t' read -r line value < <(profile_platform_line "$f") || true
      if [ -z "${line:-}" ]; then
        report "$rel" "$platline" profile "no '- Platform:' line under '## Platform'"
      else
        while IFS= read -r name; do
          name=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "$name")
          grep -qxF -- "$name" <<< "$platforms" \
            || report "$rel" "$line" profile "platform '$name' is not a value of the Platform setting"
        done < <(tr ',' '\n' <<< "$value")
      fi
    fi

    drvline=$(grep -n -m1 -x '## QA driver' "$f" | cut -d: -f1)
    if [ -n "$drvline" ]; then
      line=""
      IFS=$'\t' read -r line value < <(profile_driver_line "$f") || true
      if [ -z "${line:-}" ]; then
        report "$rel" "$drvline" profile "no '- QA driver:' line under '## QA driver'"
      elif [ "$value" != "—" ] && { [ "$value" = SKILL ] || [[ "$value" == */* ]] \
          || [ ! -f "$METHOD/skills/qa-drivers/$value.md" ]; }; then
        report "$rel" "$line" profile "QA driver '$value' is not a file of qa-drivers"
      fi
    fi

    while IFS=$'\t' read -r line name; do
      [ -n "$name" ] || continue
      grep -qxF -- "$name" <<< "$capabilities" \
        || report "$rel" "$line" profile "capability '$name' is not in the template list"
    done < <(profile_capabilities "$f")
  done
}

check_settings
check_tools
check_profiles
check_fail_closed

if [ "$breaches" -eq 0 ]; then
  echo "po-lint: no breach in $METHOD_FILE_COUNT file(s) of ${METHOD##*/}/"
else
  echo "po-lint: $breaches breach(es) in $METHOD_FILE_COUNT file(s) of ${METHOD##*/}/"
fi
[ "$breaches" -eq 0 ]
