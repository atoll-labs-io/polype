#!/usr/bin/env bash
# Copies the working tree of Polype into a project, to try it before the real distribution (M5).
#
#   polype-dev-install <project-dir> [--hooks]
#
# Commands, agents and skills land in .claude/, templates and the gate in .polype/. AGENTS.md is
# regenerated from the method's rules followed by the project's AGENTS.local.md, which is only read.
# Files installed last time and no longer shipped are deleted; the project's own files are not.
set -euo pipefail

method="$(cd "$(dirname "$0")/../method" && pwd)"
project="" hooks=no
for arg in "$@"; do
  case "$arg" in
    --hooks) hooks=yes ;;
    -*) echo "polype-dev-install: unknown option $arg" >&2; exit 2 ;;
    *) project="$arg" ;;
  esac
done
[ -n "$project" ] || { echo "usage: polype-dev-install <project-dir> [--hooks]" >&2; exit 2; }
project="$(cd "$project" && pwd)"
manifest="$project/.polype/manifest"
marker='<!-- Assembled by Polype.'

if [ -f "$manifest" ]; then
  while IFS= read -r old; do rm -f "$project/$old"; done < "$manifest"
fi
mkdir -p "$project/.polype"
: > "$manifest.next"

install_file() {
  mkdir -p "$(dirname "$project/$2")"
  cp "$1" "$project/$2"
  echo "$2" >> "$manifest.next"
}

install_tree() {
  local from="$1" to="$2" rel
  while IFS= read -r rel; do
    install_file "$from/$rel" "$to/$rel"
  done < <(cd "$from" && find . -type f | sed 's|^\./||' | sort)
}

install_tree "$method/commands" .claude/commands
install_tree "$method/agents" .claude/agents
install_tree "$method/skills" .claude/skills
install_tree "$method/templates" .polype/templates
install_tree "$method/hooks" .polype/hooks
chmod +x "$project"/.polype/hooks/*
mv "$manifest.next" "$manifest"
find "$project/.claude" "$project/.polype" -type d -empty -delete 2>/dev/null || true

# A hand-written AGENTS.md is kept aside rather than silently replaced.
if [ -f "$project/AGENTS.md" ] && ! head -n 1 "$project/AGENTS.md" | grep -qF "$marker"; then
  cp "$project/AGENTS.md" "$project/AGENTS.md.before-polype"
  echo "polype-dev-install: existing AGENTS.md saved as AGENTS.md.before-polype" >&2
fi
{
  cat "$method/AGENTS.md"
  if [ -f "$project/AGENTS.local.md" ]; then
    printf '\n---\n\n'
    cat "$project/AGENTS.local.md"
  fi
} > "$project/AGENTS.md"

touch "$project/CLAUDE.md"
grep -qx '@AGENTS.md' "$project/CLAUDE.md" || printf '@AGENTS.md\n' >> "$project/CLAUDE.md"

worktree_root=".worktrees/"
if [ -f "$project/AGENTS.local.md" ]; then
  configured="$(sed -n 's/^Worktree root:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' "$project/AGENTS.local.md" | head -n 1)"
  [ -n "$configured" ] && worktree_root="$configured"
fi
touch "$project/.gitignore"
for pattern in "$worktree_root" '.env*'; do
  grep -qxF "$pattern" "$project/.gitignore" || printf '%s\n' "$pattern" >> "$project/.gitignore"
done

if [ "$hooks" = yes ]; then
  current="$(git -C "$project" config --get core.hooksPath || true)"
  if [ -n "$current" ] && [ "$current" != ".polype/hooks" ]; then
    echo "polype-dev-install: core.hooksPath is already '$current'; left unchanged, chain .polype/hooks/pre-commit from there" >&2
  else
    git -C "$project" config core.hooksPath .polype/hooks
  fi
fi

echo "Polype installed in $project ($(wc -l < "$manifest") files). Commit .claude/, .polype/, AGENTS.md, CLAUDE.md and .gitignore on the target branch so story worktrees get them."
