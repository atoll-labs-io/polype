#!/usr/bin/env bash
# po-eval — runs the reviewer agent on stories with one planted flaw and reads a pass rate per
# case from its two verdict lines. Each run costs a paid `claude -p` call: nothing is called
# before the run count is printed and confirmed, and tests/run.sh never runs this.
#
# Usage: po-eval [--repeat N] [--model M] [--control] [case…]   every case by default, N=3
#                                                               (--control needs --model)
#        po-eval --list                            one case name per line
#        po-eval --build <case> <dir>              builds that case's repository in <dir>, prints its worktree
#
# A run passes when the report's last `Max severity:` and `Ship allowed:` lines equal the case's
# expectations, read as strictly as po-gate reads them. A report whose `Review status:` is
# `blocked` is graded `blocked` and never passes. No model grades another model here.
#
# --control runs every case a second time on a copy of this checkout whose review-antihallu step-3
# reuse sentence is replaced by `Follow YAGNI.` alone, and prints both rates side by side. Each arm
# runs on its own temporary config dir, installed globally from its own method and removed at exit,
# with the same --model, so the sentence is the only difference. Those config dirs hold no login:
# both arms need ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in the environment.
set -euo pipefail

POLYPE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CASES="$POLYPE_ROOT/evals/cases"
[ -d "$CASES" ] || { echo "po-eval runs from a Polype checkout; evals/ is not installed" >&2; exit 2; }
# shellcheck source=../evals/lib.sh
source "$POLYPE_ROOT/evals/lib.sh"

CONTROL_PREFIX='New code that an existing helper you can cite by'

usage() {
  cat >&2 <<'USAGE'
usage: po-eval [--repeat N] [--model M] [--control] [case…]   (--control needs --model)
       po-eval --list
       po-eval --build <case> <dir>
USAGE
  exit 2
}

all_cases() { find "$CASES" -maxdepth 1 -name '*.sh' -printf '%f\n' | sed 's/\.sh$//' | sort; }

load_case() {
  local name="$1" file="$CASES/$1.sh" base var
  [ -f "$file" ] || { echo "po-eval: unknown case: $name" >&2; usage; }
  for var in $(compgen -v CASE_ || true); do unset "$var"; done
  unset -f story plan plant 2>/dev/null || true
  base="$(sed -n 's/^CASE_BASE=//p' "$file" | head -n 1)"
  if [ -n "$base" ]; then
    [ -f "$CASES/$base.sh" ] || { echo "po-eval: $name: base case $base does not exist" >&2; exit 2; }
    # shellcheck source=/dev/null
    source "$CASES/$base.sh"
  fi
  # shellcheck source=/dev/null
  source "$file"
  for var in CASE_KIND CASE_DEFECT CASE_EXPECT_SEVERITY CASE_EXPECT_SHIP CASE_STORY_ID; do
    [ -n "${!var-}" ] || { echo "po-eval: $name does not declare $var" >&2; exit 2; }
  done
  [ -n "${CASE_PRESSURE+set}" ] || { echo "po-eval: $name does not declare CASE_PRESSURE" >&2; exit 2; }
  for var in story plan plant; do
    declare -F "$var" >/dev/null || { echo "po-eval: $name defines no $var function" >&2; exit 2; }
  done
}

# Claude Code may let a user-level agent or skill of the same name win over the project's copy.
drift_check() {
  local cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}" skill rel drift=0
  if [ -f "$cfg/agents/reviewer.md" ] && ! cmp -s "$cfg/agents/reviewer.md" "$POLYPE_ROOT/method/agents/reviewer.md"; then
    echo "po-eval: $cfg/agents/reviewer.md differs from method/agents/reviewer.md" >&2; drift=1
  fi
  for skill in $(awk 'NR==1 && $0=="---" {on=1; next} on && $0=="---" {exit}
                      on && /^skills:/ {list=1; next}
                      on && list && /^  - / {sub(/^  - /, ""); print; next}
                      on && list {list=0}' "$POLYPE_ROOT/method/agents/reviewer.md"); do
    [ -d "$cfg/skills/$skill" ] || continue
    while IFS= read -r rel; do
      cmp -s "$cfg/skills/$skill/$rel" "$POLYPE_ROOT/method/skills/$skill/$rel" \
        || { echo "po-eval: $cfg/skills/$skill/$rel differs from method/skills/$skill/$rel" >&2; drift=1; }
    done < <(cd "$cfg/skills/$skill" && find . -type f | sed 's|^\./||')
    while IFS= read -r rel; do
      [ -f "$cfg/skills/$skill/$rel" ] \
        || { echo "po-eval: $cfg/skills/$skill/$rel is missing (method/skills/$skill/$rel exists)" >&2; drift=1; }
    done < <(cd "$POLYPE_ROOT/method/skills/$skill" && find . -type f | sed 's|^\./||')
  done
  [ "$drift" -eq 0 ] && return 0
  echo "po-eval: a user-level copy would shadow the method under test; run bin/polype update --global" >&2
  exit 2
}

launch_message() {
  local id="$1" wt="$2" line
  line="$(grep -m1 '^> Story <id>\.' "$POLYPE_ROOT/method/commands/po-review.md" || true)"
  [ -n "$line" ] || { echo "po-eval: no '> Story <id>.' line in method/commands/po-review.md; the launch message moved" >&2; exit 2; }
  line="${line#> }"
  line="${line//<id>/"$id"}"
  line="${line//<absolute path>/"$wt"}"
  line="${line//<Target branch>/main}"
  line="${line//<n>/0}"
  if [ -n "$CASE_PRESSURE" ]; then
    printf '%s\n\n%s\n' "$line" "$CASE_PRESSURE"
  else
    printf '%s\n' "$line"
  fi
}

# Prints `blocked` for a blocked report, else `<severity>/<ship>`, or `no verdict` when either last line is missing or malformed.
grade() {
  local sev ship
  if grep -qE '^Review status:[[:space:]]*blocked[[:space:]]*$' "$1"; then echo blocked; return; fi
  sev="$(grep -E '^Max severity:' "$1" | tail -n 1 || true)"
  ship="$(grep -E '^([-*] )?Ship allowed:' "$1" | tail -n 1 | sed 's/^[-*] //' || true)"
  if [[ "$sev" =~ ^Max\ severity:[[:space:]]*(critical|major|minor|none)[[:space:]]*$ ]]; then sev="${BASH_REMATCH[1]}"; else sev=""; fi
  if [[ "$ship" =~ ^Ship\ allowed:[[:space:]]*(yes|no)[[:space:]]*$ ]]; then ship="${BASH_REMATCH[1]}"; else ship=""; fi
  if [ -n "$sev" ] && [ -n "$ship" ]; then echo "$sev/$ship"; else echo "no verdict"; fi
}

# control_setup <dir>: a copy of this checkout in <dir>/polype, its reuse sentence swapped, installed into <dir>/config.
control_setup() {
  local dir="$1" skill found
  mkdir -p "$dir/polype"
  cp -R "$POLYPE_ROOT/bin" "$POLYPE_ROOT/method" "$POLYPE_ROOT/evals" "$dir/polype/"
  skill="$dir/polype/method/skills/review-antihallu/SKILL.md"
  found="$(awk -v p="$CONTROL_PREFIX" 'index($0, p) == 1 {n++} END {print n + 0}' "$skill")"
  [ "$found" -eq 1 ] || {
    echo "po-eval: method/skills/review-antihallu/SKILL.md has $found lines starting with '$CONTROL_PREFIX', not one; the sentence moved" >&2
    exit 2
  }
  awk -v p="$CONTROL_PREFIX" 'index($0, p) == 1 {print "Follow YAGNI."; next} {print}' "$skill" > "$skill.tmp"
  mv "$skill.tmp" "$skill"
  CLAUDE_CONFIG_DIR="$dir/config" bash "$dir/polype/bin/polype" install --global >/dev/null
}

# run_arm <po-eval> <config dir or empty> <out prefix>: builds the current case, reviews it once, prints the grade.
run_arm() {
  # Called inside $(…), where bash drops errexit.
  set -e
  local po="$1" config="$2" out="$3" repo wt prompt code=0
  repo="$(mktemp -d)"
  # A separate process: inside `$(…) ||` bash would ignore set -e for the whole build.
  wt="$("$po" --build "$name" "$repo/repo" 2>"$out.build.log")" \
    || { echo "po-eval: building $name failed, see $out.build.log" >&2; rm -rf "$repo"; exit 2; }
  prompt="$(launch_message "$CASE_STORY_ID" "$wt")"
  # stdin is closed: claude -p would otherwise read what is left of ours into the prompt.
  (cd "$wt" && if [ -n "$config" ]; then export CLAUDE_CONFIG_DIR="$config"; fi
   claude -p "$prompt" --agent reviewer --allowedTools "Read Grep Glob Bash Edit" \
     --no-session-persistence ${model_args[@]+"${model_args[@]}"}) \
    < /dev/null > "$out.md" 2> "$out.err" || code=$?
  rm -rf "$repo"
  if [ "$code" -ne 0 ]; then echo "claude exit $code"; else grade "$out.md"; fi
}

# Each distinct label with its count, in order of first appearance.
tally() {
  printf '%s\n' "$@" | awk '!($0 in c) {o[++k] = $0} {c[$0]++}
    END {for (i = 1; i <= k; i++) printf "%s%s ×%d", (i > 1 ? ", " : ""), o[i], c[o[i]]}'
}

repeat=3 model="" list=no build=no control=no
selected=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repeat) [ $# -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage; repeat="$2"; shift 2 ;;
    --model) [ $# -ge 2 ] && [ -n "$2" ] || usage; model="$2"; shift 2 ;;
    --list) list=yes; shift ;;
    --control) control=yes; shift ;;
    --build) [ $# -eq 3 ] || usage; build=yes; selected=("$2"); build_dir="$3"; shift 3 ;;
    -*) echo "po-eval: unknown option $1" >&2; usage ;;
    *) selected+=("$1"); shift ;;
  esac
done

if [ "$control" = yes ] && { [ "$list" = yes ] || [ "$build" = yes ]; }; then
  echo "po-eval: --control cannot be combined with --list or --build" >&2
  exit 2
fi
if [ "$control" = yes ] && [ -z "$model" ]; then
  echo "po-eval: --control needs --model, so both arms run the same model" >&2
  exit 2
fi

if [ "$list" = yes ]; then all_cases; exit 0; fi

if [ "$build" = yes ]; then
  load_case "${selected[0]}"
  mkdir -p "$build_dir"
  eval_build "$(cd "$build_dir" && pwd)"
  exit 0
fi

[ ${#selected[@]} -gt 0 ] || mapfile -t selected < <(all_cases)
for name in "${selected[@]}"; do (load_case "$name") || exit 2; done
drift_check

if [ "$control" = yes ] && [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "po-eval: --control runs claude on a temporary config dir that holds no login; set ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN from \`claude setup-token\`" >&2
  exit 2
fi

total=$(( ${#selected[@]} * repeat ))
if [ "$control" = yes ]; then
  echo "${#selected[@]} cases × $repeat repetitions × 2 arms = $(( total * 2 )) runs of claude -p"
  logins=()
  [ -z "${ANTHROPIC_API_KEY:-}" ] || logins+=(ANTHROPIC_API_KEY)
  [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || logins+=(CLAUDE_CODE_OAUTH_TOKEN)
  echo "both arms: model $model, each on its own temporary CLAUDE_CONFIG_DIR installed from its own method, login from ${logins[0]}${logins[1]:+ and ${logins[1]}}"
else
  echo "${#selected[@]} cases × $repeat repetitions = $total runs of claude -p"
fi
printf 'Continue? [y/N] '
answer=""
read -r answer || true
[ -t 0 ] || echo
case "$answer" in
  y|Y|yes|YES|Yes) ;;
  *) echo "nothing run"; exit 1 ;;
esac

if [ "$control" = yes ]; then
  ctl="$(mktemp -d)"
  trap 'rm -rf "$ctl"' EXIT
  control_setup "$ctl"
  CLAUDE_CONFIG_DIR="$ctl/rule-config" bash "$POLYPE_ROOT/bin/polype" install --global >/dev/null
fi

results="$(mktemp -d)"
echo "results: $results"
rule_config=""
[ "$control" != yes ] || rule_config="$ctl/rule-config"
model_args=()
[ -z "$model" ] || model_args=(--model "$model")

for name in "${selected[@]}"; do
  load_case "$name"
  mkdir -p "$results/$name"
  expected="$CASE_EXPECT_SEVERITY/$CASE_EXPECT_SHIP"
  passed=0 cpassed=0
  labels=() clabels=()
  for n in $(seq 1 "$repeat"); do
    label="$(run_arm "$POLYPE_ROOT/bin/po-eval" "$rule_config" "$results/$name/$n")"
    [ "$label" = "$expected" ] && passed=$((passed + 1))
    labels+=("$label")
    if [ "$control" = yes ]; then
      label="$(run_arm "$ctl/polype/bin/po-eval" "$ctl/config" "$results/$name/$n.control")"
      [ "$label" = "$expected" ] && cpassed=$((cpassed + 1))
      clabels+=("$label")
    fi
  done
  if [ "$control" = yes ]; then
    echo "$name: rule $passed/$repeat ($(( passed * 100 / repeat ))%) | control $cpassed/$repeat ($(( cpassed * 100 / repeat ))%) — expected $expected; rule got $(tally "${labels[@]}"); control got $(tally "${clabels[@]}")"
  else
    echo "$name: $passed/$repeat passed ($(( passed * 100 / repeat ))%) — expected $expected; got $(tally "${labels[@]}")"
  fi
done

echo "results: $results"
