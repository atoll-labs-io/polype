#!/usr/bin/env bash
# The forge double of a real run: tests/journey/doubles/gh, read in place, with what a case sets
# under $JOURNEY_DIR/gh/ — `issues.json` answers `issue list` and `issue view`, `fail-issue-list`
# makes the listing fail and `fail-auth` makes every call fail as a logged-out gh does. The account
# is `me`. `--jq` is applied to `pr` and `issue` answers, as gh does. Every text a call could send
# — its standard input and every file an argument names, whatever the spelling (capture.sh) — is
# appended to calls/gh-inputs, so a grade reads every text that reached the forge.
set -u
J="$JOURNEY_DIR"
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")" && pwd)"
inner="$(cd "$here/../../../tests/journey/doubles" && pwd)/gh"
# shellcheck source=capture.sh
source "$here/capture.sh"
mkdir -p "$J/calls"
log() { printf '%s\n' "$*" >> "$J/calls/gh"; }
if [ -e "$J/gh/fail-auth" ]; then
  log "$@"
  echo "To get started with GitHub CLI, please run:  gh auth login" >&2
  exit 4
fi
capture_sent "$J/calls/gh-inputs" "$@"
prev="" jq_expr="" args=()
for a in "$@"; do
  if [ "$prev" = --jq ] && [ "${1:-}" != api ]; then jq_expr="$a"; args=("${args[@]:0:${#args[@]}-1}"); prev=""; continue; fi
  args+=("$a"); prev="$a"
done
answer() { if [ -n "$jq_expr" ]; then jq -r "$jq_expr"; else cat; fi; }
case "${1:-} ${2:-}" in
  "auth status")
    log "$@"
    case " $* " in *" --json "*) echo '{"hosts":{"github.com":[{"state":"success","active":true,"host":"github.com","login":"me"}]}}' | answer ;; esac
    exit 0 ;;
  "issue list")
    log "$@"
    [ ! -e "$J/gh/fail-issue-list" ] || { echo "HTTP 502: Bad Gateway" >&2; exit 1; }
    if [ -f "$J/gh/issues.json" ]; then jq '[.[] | {number, title, author}]' "$J/gh/issues.json" | answer; else echo '[]' | answer; fi
    exit 0 ;;
  "issue view")
    log "$@"
    n="${3:-}"
    jq -e --argjson n "${n:-0}" '.[] | select(.number == $n)' "$J/gh/issues.json" > /dev/null 2>&1 \
      || { echo "GraphQL: Could not resolve to an issue with the number of $n." >&2; exit 1; }
    jq --argjson n "$n" '.[] | select(.number == $n) | {url: "https://github.com/acme/project/issues/\(.number)", title, body}' \
      "$J/gh/issues.json" | answer
    exit 0 ;;
esac
if [ -n "$jq_expr" ]; then
  out="$("$inner" "${args[@]}" < "$CAPTURE_STDIN")" || { status=$?; printf '%s\n' "$out"; exit "$status"; }
  printf '%s\n' "$out" | answer
else
  exec "$inner" "${args[@]}" < "$CAPTURE_STDIN"
fi
